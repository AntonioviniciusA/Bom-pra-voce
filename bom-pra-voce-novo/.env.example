# Public configuration only. Never put a secret/service_role/database password here.
# Copy to .env.local after the backend contracts are implemented and verified.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_PUBLISHABLE_KEY=
REACT_APP_TURNSTILE_SITE_KEY=
# Keep false until the definitive domain, a production Turnstile widget,
# approved privacy data and end-to-end receipt/deletion tests are ready.
REACT_APP_APPLICATIONS_ENABLED=false
